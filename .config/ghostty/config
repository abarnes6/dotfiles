theme = Apple System Colors
keybind = global:option+grave_accent=toggle_quick_terminal

# Generated by Spectre v0.3.0 - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config

# Fonts
font-size = 14

# Cursor
cursor-style = bar

# Shell
shell-integration = zsh

# Application
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify,bell
maximize = true

# Quick-terminal
quick-terminal-position = center
quick-terminal-size = 20%

# Macos
macos-icon = blueprint
auto-update = download
auto-update-channel = tip

# Advanced
custom-shader-animation = true
