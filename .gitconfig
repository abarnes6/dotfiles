[user]
	email = andrew.barnes@watchfiresigns.com
	name = Andrew Barnes
[advice]
	forceDeleteBranch = false
[pull]
	rebase = false
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  dark = true
[merge]
  conflictstyle = zdiff3
